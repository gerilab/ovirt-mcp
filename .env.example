# ==============================================================================
# oVirt / Oracle Linux Virtualization Manager (OLVM) MCP Configuration
# ==============================================================================

# oVirt / OLVM Engine REST API URL (usually ends with /ovirt-engine/api)
OVIRT_URL=https://olvm.example.com/ovirt-engine/api

# Authentication credentials
# Note: For internal admin, use user@internal (e.g. admin@internal)
OVIRT_USERNAME=admin@internal
OVIRT_PASSWORD=your_secure_password_here

# TLS / SSL Certificate Configuration
# Path to the oVirt / OLVM CA certificate in PEM format.
# You can leave this empty if OVIRT_INSECURE=true or if using auto-download.
OVIRT_CA_FILE=

# Allow insecure connection (disable TLS verification - recommended for lab only)
OVIRT_INSECURE=false

# Auto-download CA certificate from engine PKI endpoint if OVIRT_CA_FILE is empty
OVIRT_AUTO_DOWNLOAD_CA=true

# Connection timeouts in seconds
OVIRT_TIMEOUT=30
OVIRT_MAX_RETRIES=3

# Logging & Operational Configuration
MCP_LOG_LEVEL=INFO
MCP_SAFE_MODE=true
MCP_READ_ONLY=false
MCP_COMPACT_MODE=false
